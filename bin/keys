#!/usr/bin/env bash
# Keeper → Keychain one-way sync (Option 2: Keeper is source of truth).
#
# Convention: records inside the `ENV_FOLDER` folder in Keeper whose title
# matches `TITLE_REGEX` are treated as env vars. Each record's password
# field is mirrored to a macOS Keychain entry with the record title as the
# service name. zshrc iterates the names file at shell start and exports
# each present Keychain entry.
#
# Adjust ENV_FOLDER below if you rename the folder in Keeper.
#
# Subcommands: list, sync, rm
set -euo pipefail

NAMES_FILE="$HOME/.dotfiles-keychain-names"
ENV_FOLDER="env-vars"
TITLE_REGEX='^[A-Z][A-Z0-9_]+$'

cmd="${1:-}"
case "$cmd" in
  list)
    if [ ! -f "$NAMES_FILE" ]; then
      echo "No names list yet. Run 'dots keys sync' to populate." >&2
      exit 0
    fi
    while IFS= read -r name; do
      [ -z "$name" ] && continue
      if security find-generic-password -s "$name" -a "$USER" -w >/dev/null 2>&1; then
        printf '%-30s present\n' "$name"
      else
        printf '%-30s MISSING\n' "$name"
      fi
    done < "$NAMES_FILE"
    ;;

  sync)
    if ! command -v keeper >/dev/null 2>&1; then
      echo "error: keepercommander not installed. Run dots bootstrap first." >&2
      exit 1
    fi
    if ! command -v jq >/dev/null 2>&1; then
      echo "error: jq not installed. Run dots bootstrap first." >&2
      exit 1
    fi

    # Single keeper call: export the ENV_FOLDER folder as JSON to stdout
    # (omitting the positional filename = console output).
    # --force suppresses any interactive confirmation.
    raw=$(keeper export --folder "$ENV_FOLDER" --format=json --force 2>&1)

    if [ -z "$raw" ]; then
      echo "error: 'keeper export --folder $ENV_FOLDER' returned nothing." >&2
      exit 1
    fi

    # Strip anything before the first line starting with '[' or '{' — keeper
    # may prefix auth prompts or diagnostics to stdout when session expires.
    json=$(printf '%s\n' "$raw" | awk '/^[[:space:]]*[\[{]/ {found=1} found {print}')

    if [ -z "$json" ] || ! printf '%s' "$json" | jq empty >/dev/null 2>&1; then
      cat >&2 <<EOF

⚠ Could not parse Keeper output as JSON. Usually this means your Keeper session
  needs to be refreshed. Run this in your terminal, then retry:

      keeper login
      dots keys sync

EOF
      exit 2
    fi

    # Extract (title, password) for records whose title matches the env-var
    # regex and whose password is non-empty. Handles both array-root and
    # object-root top-level shapes.
    pairs=$(printf '%s' "$json" | jq -r --arg re "$TITLE_REGEX" '
      (if type == "array" then . else (.records // []) end)
      | .[]
      | select((.title // "") | test($re))
      | select((.password // "") != "")
      | "\(.title)\t\(.password)"
    ')

    if [ -z "$pairs" ]; then
      echo "No env-var-style records with passwords found in '$ENV_FOLDER'." >&2
      exit 0
    fi

    fetched=0; skipped_dupe=0
    names_tmp=$(mktemp)
    seen_tmp=$(mktemp)
    while IFS=$'\t' read -r title value; do
      [ -z "$title" ] && continue
      if grep -Fxq "$title" "$seen_tmp" 2>/dev/null; then
        echo "⚠ $title: duplicate record in '$ENV_FOLDER' (keeping first)" >&2
        skipped_dupe=$((skipped_dupe+1))
        continue
      fi
      printf '%s\n' "$title" >> "$seen_tmp"
      security add-generic-password -U -s "$title" -a "$USER" -w "$value"
      printf '%s\n' "$title" >> "$names_tmp"
      echo "✓ $title"
      fetched=$((fetched+1))
    done <<< "$pairs"
    rm -f "$seen_tmp"
    mv "$names_tmp" "$NAMES_FILE"
    echo ""
    echo "Synced $fetched to Keychain (skipped $skipped_dupe dupes). One keeper call."
    ;;

  add)
    name="${2:-}"
    if [ -z "$name" ]; then
      echo "usage: keys add <NAME> [VALUE]" >&2
      echo "  VALUE omitted → prompt (recommended; argv leaks to history and ps)" >&2
      exit 1
    fi
    if ! [[ "$name" =~ ^[A-Z][A-Z0-9_]+$ ]]; then
      echo "error: NAME must be UPPER_SNAKE_CASE (e.g. MY_API_TOKEN)" >&2
      exit 1
    fi
    if [ "$#" -ge 3 ]; then
      echo "⚠ passing VALUE on argv leaks the secret to shell history and 'ps'." >&2
      echo "  prefer 'dots keys add $name' to be prompted." >&2
      value="$3"
    else
      read -rs -p "value: " value
      echo
      if [ -z "$value" ]; then
        echo "error: empty value" >&2
        exit 1
      fi
    fi
    keeper record-add -t "$name" --folder "$ENV_FOLDER" -rt login "password=$value"
    "$0" sync
    ;;

  gen)
    # Generate a random password *inside Keeper* and sync it like `add`, without
    # the value ever being seen. Generation is delegated to Keeper's `$GEN`
    # token: only the literal template (e.g. $GEN:rand,32) appears on keeper's
    # argv — the generated secret is produced server-side and never touches the
    # command line, shell history, ps, stdout, or this repo. Randomness is
    # Keeper's CSPRNG (never $RANDOM).
    #
    # NOTE: $GEN:rand accepts only an algorithm + numeric length (verified
    # against Commander's record_edit.py); it has no symbol-exclusion option,
    # so there is intentionally no --no-symbols flag.
    shift
    name="" length=32 rotate=0 dry=0
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --length)   shift; length="${1:-}" ;;
        --length=*) length="${1#--length=}" ;;
        --rotate)   rotate=1 ;;
        --dry-run)  dry=1 ;;
        --*)        echo "error: unknown flag '$1'" >&2; exit 1 ;;
        *)
          if [ -z "$name" ]; then name="$1"
          else echo "error: unexpected argument '$1'" >&2; exit 1; fi
          ;;
      esac
      shift
    done

    if [ -z "$name" ]; then
      echo "usage: keys gen <NAME> [--length N] [--rotate] [--dry-run]" >&2
      echo "  generate a random password in Keeper (env-vars folder) and sync it" >&2
      echo "  the value is generated by Keeper and never displayed" >&2
      exit 1
    fi
    if ! [[ "$name" =~ ^[A-Z][A-Z0-9_]+$ ]]; then
      echo "error: NAME must be UPPER_SNAKE_CASE (e.g. MY_API_TOKEN)" >&2
      exit 1
    fi
    if ! [[ "$length" =~ ^[0-9]+$ ]]; then
      echo "error: --length must be an integer (got '$length')" >&2
      exit 1
    fi
    if [ "$length" -lt 8 ]; then
      echo "error: --length must be >= 8 (got $length)" >&2
      exit 1
    fi
    # Keeper's $GEN:rand silently clamps to <=200; reject above that so a typo
    # like --length 100000 fails loudly instead of quietly yielding 200 chars.
    if [ "$length" -gt 200 ]; then
      echo "error: --length must be <= 200 (Keeper caps generation at 200)" >&2
      exit 1
    fi

    # In double quotes, \$ is a literal '$', so the token below is the literal
    # string $GEN:rand,<length> — Keeper expands it, not the shell.
    gen_token="\$GEN:rand,$length"

    # --dry-run: show the exact keeper invocation (template only — no secret
    # exists yet) and make no network call. Offline + safe to assert in tests.
    if [ "$dry" -eq 1 ]; then
      # NAME is validated UPPER_SNAKE and ENV_FOLDER is a fixed token, so neither
      # needs quoting; single-quote the password arg so the $GEN token is shown
      # exactly as it must be typed (literal, unexpanded by the shell).
      if [ "$rotate" -eq 1 ]; then
        printf "keeper record-update -r %s 'password=%s'\n" "$name" "$gen_token"
      else
        printf "keeper record-add -t %s --folder %s -rt login 'password=%s'\n" \
          "$name" "$ENV_FOLDER" "$gen_token"
      fi
      exit 0
    fi

    if ! command -v keeper >/dev/null 2>&1; then
      echo "error: keepercommander not installed. Run dots bootstrap first." >&2
      exit 1
    fi
    if ! command -v jq >/dev/null 2>&1; then
      echo "error: jq not installed. Run dots bootstrap first." >&2
      exit 1
    fi

    # Detect an existing record with this title so we never silently create a
    # duplicate. Same export-and-strip approach as `sync`.
    raw=$(keeper export --folder "$ENV_FOLDER" --format=json --force 2>&1) || true
    json=$(printf '%s\n' "$raw" | awk '/^[[:space:]]*[\[{]/ {found=1} found {print}')
    if [ -z "$json" ] || ! printf '%s' "$json" | jq empty >/dev/null 2>&1; then
      cat >&2 <<EOF

⚠ Could not parse Keeper output as JSON. Usually this means your Keeper session
  needs to be refreshed. Run this in your terminal, then retry:

      keeper login
      dots keys gen $name

EOF
      exit 2
    fi
    exists=$(printf '%s' "$json" | jq -r --arg t "$name" '
      [ (if type == "array" then . else (.records // []) end)[]
        | select((.title // "") == $t) ] | length')

    if [ "$exists" -gt 0 ] && [ "$rotate" -eq 0 ]; then
      echo "error: '$name' already exists in Keeper folder '$ENV_FOLDER'." >&2
      echo "  pass --rotate to generate a new value and overwrite it." >&2
      exit 1
    fi

    # record-update -r accepts a title or UID; record-add creates a new record.
    if [ "$exists" -gt 0 ]; then
      keeper record-update -r "$name" "password=$gen_token"
      echo "↻ rotated $name"
    else
      keeper record-add -t "$name" --folder "$ENV_FOLDER" -rt login "password=$gen_token"
      echo "+ created $name"
    fi

    # Mirror into Keychain + names file. sync prints names only, never values.
    "$0" sync
    echo ""
    echo "✓ $name generated and stored (value never displayed)."
    ;;

  rm)
    name="${2:-}"
    if [ -z "$name" ]; then echo "usage: keys rm <NAME>" >&2; exit 1; fi
    if security delete-generic-password -s "$name" -a "$USER" >/dev/null 2>&1; then
      echo "✓ removed $name from Keychain"
    else
      echo "⚠ $name not in Keychain"
    fi
    if [ -f "$NAMES_FILE" ]; then
      tmp=$(mktemp)
      grep -v "^$name$" "$NAMES_FILE" > "$tmp" || true
      mv "$tmp" "$NAMES_FILE"
    fi
    echo "Note: Keeper record untouched — delete manually in Keeper if desired."
    ;;

  nas-env)
    if [ ! -f "$NAMES_FILE" ]; then
      echo "error: no names list ($NAMES_FILE). Run 'dots keys sync' first." >&2
      exit 1
    fi
    emitted=0
    while IFS= read -r name; do
      [ -z "$name" ] && continue
      val=$(security find-generic-password -s "$name" -a "$USER" -w 2>/dev/null) || {
        echo "warn: $name missing from Keychain" >&2; continue; }
      [ -z "$val" ] && { echo "warn: $name empty in Keychain" >&2; continue; }
      printf '%s=%s\n' "$name" "$val"
      emitted=$((emitted + 1))
    done < "$NAMES_FILE"
    if [ "$emitted" -eq 0 ]; then
      echo "error: emitted 0 secrets (Keychain locked?). Aborting." >&2
      exit 1
    fi
    ;;

  *)
    cat >&2 <<EOF
usage: keys <command>

  add NAME [VALUE]  create a Keeper record and sync it to Keychain
                    (omit VALUE to be prompted; argv leaks to history and ps)
  gen NAME [opts]   generate a random password in Keeper and sync it; the value
                    is generated by Keeper and never displayed. Options:
                      --length N  password length (default 32, min 8)
                      --rotate    overwrite NAME if it already exists
                      --dry-run   print the keeper command without running it
  list            show each env-var in the names list (present|MISSING in Keychain)
  nas-env           emit NAME=value for the NAS toolbox (stdout only; macOS)
  sync            pull every ENV_VAR_STYLE-titled Keeper record into Keychain
  rm NAME         remove from Keychain (Keeper record untouched)

Adding a key: create a record in Keeper with an env-var-style title
(e.g., TODOIST_API_TOKEN) and put the value in the password field.
Then run 'dots keys sync'. No local manifest to edit.
EOF
    exit 1
    ;;
esac
