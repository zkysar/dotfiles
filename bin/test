#!/usr/bin/env bash
# Run repo self-tests: manifest integrity, shell syntax, secrets scan.
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
MANIFEST="$REPO_ROOT/manifest.toml"

pass=0; fail=0

ok()   { echo "  ✓ $*"; pass=$((pass+1)); }
fail() { echo "  ✗ $*"; fail=$((fail+1)); }

# Current OS (mirrors bin/link / bin/doctor). Entries tagged with a
# non-matching `platform` are skipped — e.g. macOS-only external paths are not
# expected to exist on Linux.
case "$(uname -s)" in
  Darwin) THIS_PLATFORM=macos ;;
  Linux)  THIS_PLATFORM=linux ;;
  *)      THIS_PLATFORM=unknown ;;
esac
THIS_PLATFORM="${DOTS_PLATFORM:-$THIS_PLATFORM}"

# ---------------------------------------------------------------------------
# 1. Manifest integrity — every src path for this platform must exist
# ---------------------------------------------------------------------------
echo "1. Manifest integrity"
while IFS=$'\t' read -r src platform; do
  [ -z "$src" ] && continue
  platform="${platform:-all}"
  if [ "$platform" != "all" ] && [ "$platform" != "$THIS_PLATFORM" ]; then
    continue
  fi
  case "$src" in
    "~/"*) check_path="${src/#\~/$HOME}" ;;
    /*)    check_path="$src" ;;
    *)     check_path="$REPO_ROOT/$src" ;;
  esac
  if [ -e "$check_path" ]; then
    ok "$src"
  else
    fail "$src (missing from repo or external path)"
  fi
done < <(awk '
  /^\[\[link\]\]/ { in_link=1; src=""; platform=""; next }
  in_link && /^src[[:space:]]*=/      { match($0, /"[^"]*"/); src      = substr($0, RSTART+1, RLENGTH-2) }
  in_link && /^platform[[:space:]]*=/ { match($0, /"[^"]*"/); platform = substr($0, RSTART+1, RLENGTH-2) }
  in_link && /^dest[[:space:]]*=/ {
    if (src != "") print src "\t" platform
    in_link=0
  }
' "$MANIFEST")

# ---------------------------------------------------------------------------
# 2. Shell syntax check
# ---------------------------------------------------------------------------
echo "2. Shell syntax"
while IFS= read -r -d '' f; do
  rel="${f#$REPO_ROOT/}"
  if zsh -n "$f" 2>/dev/null; then
    ok "$rel"
  else
    fail "$rel (syntax error)"
  fi
done < <(find "$REPO_ROOT/shell" -type f -print0)

# ---------------------------------------------------------------------------
# 3. Secrets scan (delegated to gitleaks; .gitleaks.toml at repo root tunes it)
# ---------------------------------------------------------------------------
echo "3. Secrets scan"
if ! command -v gitleaks >/dev/null 2>&1; then
  fail "gitleaks not installed — run bin/bootstrap"
elif gl_out=$(gitleaks git --redact --no-banner "$REPO_ROOT" 2>&1); then
  ok "no secrets detected (gitleaks)"
else
  fail "gitleaks found secrets — run \`gitleaks git --redact $REPO_ROOT\` for details"
  printf '%s\n' "$gl_out" | sed 's/^/      /'
fi

# ---------------------------------------------------------------------------
# 4. Backup pruning — bin/_prune-backups removes >30-day-old entries
# ---------------------------------------------------------------------------
echo "4. Backup pruning"
prune_test_root="$(mktemp -d -t dots-prune.XXXXXX)"
mkdir "$prune_test_root/old_entry" "$prune_test_root/recent_entry"
# BSD touch (macOS): -t [[CC]YY]MMDDhhmm sets mtime. 60 days back → >30 days old.
old_stamp="$(date -v-60d +%Y%m%d0000 2>/dev/null || date -d '60 days ago' +%Y%m%d0000)"
touch -t "$old_stamp" "$prune_test_root/old_entry"

prune_out="$("$REPO_ROOT/bin/_prune-backups" "$prune_test_root" 2>&1 || true)"

if [ ! -e "$prune_test_root/old_entry" ] && [ -d "$prune_test_root/recent_entry" ]; then
  ok "old backup pruned, recent backup retained"
else
  fail "prune did not behave as expected (output: $prune_out)"
fi
rm -rf "$prune_test_root"

# Missing backup root must not error
if "$REPO_ROOT/bin/_prune-backups" "/nonexistent/dotfiles-backup-$$" >/dev/null 2>&1; then
  ok "prune handles missing backup root cleanly"
else
  fail "prune errored on missing backup root"
fi

# ---------------------------------------------------------------------------
# 5. requires_local — dots doctor flags a missing untracked companion file
# ---------------------------------------------------------------------------
echo "5. requires_local (doctor)"
rl_tmp="$(mktemp -d -t dots-rl.XXXXXX)"
: > "$rl_tmp/present.local"
cat > "$rl_tmp/manifest.toml" <<EOF
[[link]]
src            = "manifest.toml"
requires_local = "$rl_tmp/missing.local"
dest           = "$rl_tmp/dest_missing"

[[link]]
src            = "manifest.toml"
requires_local = "$rl_tmp/present.local"
dest           = "$rl_tmp/dest_present"
EOF
rl_out="$(MANIFEST="$rl_tmp/manifest.toml" "$REPO_ROOT/bin/doctor" 2>&1 || true)"
if printf '%s' "$rl_out" | grep -qF "$rl_tmp/missing.local"; then
  ok "flags missing required-local companion"
else
  fail "did not flag missing required-local companion"
fi
if printf '%s' "$rl_out" | grep -qF "$rl_tmp/present.local"; then
  fail "incorrectly flagged a present required-local companion"
else
  ok "does not flag present required-local companion"
fi
rm -rf "$rl_tmp"

# ---------------------------------------------------------------------------
# 6. Platform filter — bin/link skips entries whose platform != current OS
# ---------------------------------------------------------------------------
echo "6. Platform filter (bin/link)"
pf_tmp="$(mktemp -d -t dots-pf.XXXXXX)"
: > "$pf_tmp/srcfile"
cat > "$pf_tmp/manifest.toml" <<EOF
[[link]]
src      = "$pf_tmp/srcfile"
platform = "macos"
dest     = "$pf_tmp/dest_macos"

[[link]]
src      = "$pf_tmp/srcfile"
platform = "linux"
dest     = "$pf_tmp/dest_linux"

[[link]]
src  = "$pf_tmp/srcfile"
dest = "$pf_tmp/dest_all"
EOF
HOME="$pf_tmp" MANIFEST="$pf_tmp/manifest.toml" DOTS_PLATFORM=linux \
  "$REPO_ROOT/bin/link" >/dev/null 2>&1 || true
if [ -L "$pf_tmp/dest_linux" ] && [ -L "$pf_tmp/dest_all" ] && [ ! -e "$pf_tmp/dest_macos" ]; then
  ok "linux + all linked, macos skipped (DOTS_PLATFORM=linux)"
else
  fail "platform filter wrong: linux=$([ -L "$pf_tmp/dest_linux" ] && echo L) all=$([ -L "$pf_tmp/dest_all" ] && echo L) macos=$([ -e "$pf_tmp/dest_macos" ] && echo present)"
fi
rm -rf "$pf_tmp"

# ---------------------------------------------------------------------------
# 7. bin/ script syntax — every executable script must parse
# ---------------------------------------------------------------------------
echo "7. bin/ syntax"
while IFS= read -r -d '' f; do
  rel="${f#$REPO_ROOT/}"
  # Only shell scripts; skip symlinks (e.g. bin/obsidian) and non-scripts.
  [ -L "$f" ] && continue
  head -1 "$f" | grep -q '^#!.*\(bash\|sh\)' || continue
  if bash -n "$f" 2>/dev/null; then
    ok "$rel"
  else
    fail "$rel (syntax error)"
  fi
done < <(find "$REPO_ROOT/bin" -maxdepth 1 -type f -print0)

# ---------------------------------------------------------------------------
# 8. bin/style — derives a valid 16-color scheme from ghostty/config
# ---------------------------------------------------------------------------
echo "8. style scheme"
if ! command -v jq >/dev/null 2>&1; then
  fail "jq not installed — run bin/bootstrap"
else
  # Capture the exit code and reject empty output explicitly: `jq empty` returns
  # 0 on an empty file, so without these guards a crashed bin/style would pass
  # the "valid JSON" check on no output at all.
  style_tmp="$(mktemp)"
  if ! "$REPO_ROOT/bin/style" --print-scheme > "$style_tmp" 2>/dev/null; then
    fail "bin/style --print-scheme exited non-zero"
  elif [ ! -s "$style_tmp" ]; then
    fail "bin/style --print-scheme produced no output"
  elif jq empty "$style_tmp" 2>/dev/null; then
    ok "scheme is valid JSON"
  else
    fail "scheme is not valid JSON (output: $(cat "$style_tmp"))"
  fi
  # name + the 16 ANSI color keys must all be present.
  missing=""
  for k in name black red green yellow blue purple cyan white \
           brightBlack brightRed brightGreen brightYellow brightBlue \
           brightPurple brightCyan brightWhite; do
    jq -e --arg k "$k" 'has($k)' "$style_tmp" >/dev/null 2>&1 || missing="$missing $k"
  done
  if [ -z "$missing" ]; then
    ok "scheme has name + all 16 ANSI colors"
  else
    fail "scheme missing keys:$missing"
  fi
  rm -f "$style_tmp"

  # The settings.json transform (the part that mutates a real WT config) must:
  # merge exactly one dots-onedark scheme (idempotent — fixture already has one),
  # restyle the Ubuntu profile, and leave unrelated profiles untouched.
  wt_tmp="$(mktemp)"
  cat > "$wt_tmp" <<'EOF'
{"schemes":[{"name":"dots-onedark"},{"name":"Campbell"}],
 "profiles":{"list":[{"name":"Ubuntu"},{"name":"PowerShell"}]}}
EOF
  rendered="$("$REPO_ROOT/bin/style" --render "$wt_tmp" 2>/dev/null || true)"
  if [ -z "$rendered" ] || ! jq empty <<<"$rendered" 2>/dev/null; then
    fail "bin/style --render produced no/invalid JSON"
  else
    n_scheme="$(jq '[.schemes[] | select(.name=="dots-onedark")] | length' <<<"$rendered")"
    ubuntu_cs="$(jq -r '.profiles.list[] | select(.name=="Ubuntu") | .colorScheme // ""' <<<"$rendered")"
    ps_styled="$(jq -r '.profiles.list[] | select(.name=="PowerShell") | has("colorScheme")' <<<"$rendered")"
    if [ "$n_scheme" = "1" ] && [ "$ubuntu_cs" = "dots-onedark" ] && [ "$ps_styled" = "false" ]; then
      ok "settings transform: idempotent scheme merge, Ubuntu styled, others untouched"
    else
      fail "settings transform wrong (schemes=$n_scheme ubuntu_cs=$ubuntu_cs ps_styled=$ps_styled)"
    fi
  fi
  rm -f "$wt_tmp"
fi

# ---------------------------------------------------------------------------
# 9. bootstrap release_arch — uname -m → vendor asset arch token
# ---------------------------------------------------------------------------
echo "9. bootstrap arch mapping"
arch_check="$(DOTS_BOOTSTRAP_LIB=1 bash -c '
  source "'"$REPO_ROOT"'/bin/bootstrap"
  [ "$(DOTS_UNAME_M=x86_64  release_arch gitleaks)" = "x64"   ] &&
  [ "$(DOTS_UNAME_M=aarch64 release_arch gitleaks)" = "arm64" ] &&
  [ "$(DOTS_UNAME_M=x86_64  release_arch gh)"       = "amd64" ] &&
  [ "$(DOTS_UNAME_M=aarch64 release_arch gh)"       = "arm64" ] &&
  ! DOTS_UNAME_M=riscv64 release_arch gitleaks >/dev/null 2>&1 &&
  echo OK' 2>/dev/null || true)"
if [ "$arch_check" = "OK" ]; then
  ok "release_arch maps x86_64/aarch64 for gitleaks+gh and rejects unknown"
else
  fail "release_arch mapping incorrect"
fi

# ---------------------------------------------------------------------------
# 10. keys gen — arg parsing, validation, and the offline --dry-run template
#     (--dry-run makes no keeper/jq call, so this is safe in CI on any OS)
# ---------------------------------------------------------------------------
echo "10. keys gen (dry-run + validation)"
KEYS="$REPO_ROOT/bin/keys"

# Helper: run keys gen, capture stdout+stderr and the real exit code without
# tripping `set -e` (a failing command substitution in an assignment is fatal
# otherwise; the && / || chain suppresses that and preserves the code).
gen_out=""; gen_rc=0
run_gen() { gen_out="$(bash "$KEYS" gen "$@" 2>&1)" && gen_rc=0 || gen_rc=$?; }

run_gen GEN_TEST_TOKEN --dry-run
if [ "$gen_rc" -eq 0 ] && printf '%s' "$gen_out" | grep -qF 'record-add' \
   && printf '%s' "$gen_out" | grep -qF '$GEN:rand,32'; then
  ok "default dry-run emits record-add with \$GEN:rand,32"
else
  fail "default dry-run wrong (rc=$gen_rc out: $gen_out)"
fi

run_gen GEN_TEST_TOKEN --length 48 --dry-run
if [ "$gen_rc" -eq 0 ] && printf '%s' "$gen_out" | grep -qF '$GEN:rand,48'; then
  ok "--length is honored in the template"
else
  fail "--length not honored (rc=$gen_rc out: $gen_out)"
fi

run_gen GEN_TEST_TOKEN --rotate --dry-run
if [ "$gen_rc" -eq 0 ] && printf '%s' "$gen_out" | grep -qF 'record-update'; then
  ok "--rotate dry-run emits record-update"
else
  fail "--rotate did not switch to record-update (rc=$gen_rc out: $gen_out)"
fi

# The generated secret must never be on keeper's argv — only the literal token.
if printf '%s' "$gen_out" | grep -qF '$GEN'; then
  ok "dry-run shows only the \$GEN template, no literal secret"
else
  fail "dry-run template missing \$GEN marker (out: $gen_out)"
fi

# Validation: bad NAME, non-numeric/too-small length, and missing NAME all fail
# before any keeper call.
run_gen lowercase_name --dry-run
[ "$gen_rc" -ne 0 ] && ok "rejects non-UPPER_SNAKE NAME" || fail "accepted bad NAME"

run_gen GEN_TEST_TOKEN --length abc --dry-run
[ "$gen_rc" -ne 0 ] && ok "rejects non-numeric --length" || fail "accepted non-numeric length"

run_gen GEN_TEST_TOKEN --length 4 --dry-run
[ "$gen_rc" -ne 0 ] && ok "rejects --length below floor (8)" || fail "accepted too-small length"

run_gen GEN_TEST_TOKEN --length 9999 --dry-run
[ "$gen_rc" -ne 0 ] && ok "rejects --length above cap (200)" || fail "accepted over-cap length"

run_gen --dry-run
[ "$gen_rc" -ne 0 ] && ok "requires a NAME argument" || fail "ran without a NAME"

# ---------------------------------------------------------------------------
# Summary
# ---------------------------------------------------------------------------
echo ""
total=$((pass+fail))
if [ "$fail" -eq 0 ]; then
  echo "✓ all $total checks passed"
  exit 0
else
  echo "✗ $fail/$total checks failed"
  exit 1
fi
